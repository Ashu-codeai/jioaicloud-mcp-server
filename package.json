{
  "name": "jio-mcp-server",
  "version": "1.0.0",
  "description": "Local MCP server for JioAICloud backup inventory, duplicates, and file management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jioaicloud-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "keywords": ["mcp", "jioaicloud", "jiocloud"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
